class DNode {
    int val;
    DNode prev, next;
    DNode(int val) { this.val = val; }
}

public class P42_DoublyLinkedList_BasicOperations {
    static DNode head, tail;

    static void insertEnd(int val) {
        DNode node = new DNode(val);
        if (head == null) { head = tail = node; return; }
        tail.next = node;
        node.prev = tail;
        tail = node;
    }

    static void traverseForward() {
        DNode temp = head;
        while (temp != null) { System.out.print(temp.val + " "); temp = temp.next; }
        System.out.println();
    }

    static void traverseBackward() {
        DNode temp = tail;
        while (temp != null) { System.out.print(temp.val + " "); temp = temp.prev; }
        System.out.println();
    }

    static void deleteNode(int val) {
        DNode temp = head;
        while (temp != null) {
            if (temp.val == val) {
                if (temp.prev != null) temp.prev.next = temp.next;
                else head = temp.next;
                if (temp.next != null) temp.next.prev = temp.prev;
                else tail = temp.prev;
                return;
            }
            temp = temp.next;
        }
    }

    public static void main(String[] args) {
        for (int v : new int[]{1, 2, 3, 4, 5}) insertEnd(v);
        traverseForward();
        traverseBackward();
        deleteNode(3);
        traverseForward();
    }
}
