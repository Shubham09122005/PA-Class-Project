class SNode {
    int val;
    SNode next;
    SNode(int val) { this.val = val; }
}

public class P37_SinglyLinkedList_NthFromEnd {
    static SNode nthFromEnd(SNode head, int n) {
        SNode first = head, second = head;
        for (int i = 0; i < n; i++) first = first.next;
        while (first != null) {
            first = first.next;
            second = second.next;
        }
        return second;
    }

    public static void main(String[] args) {
        SNode dummy = new SNode(0);
        SNode curr = dummy;
        curr.next = new SNode(1); curr = curr.next;
        curr.next = new SNode(2); curr = curr.next;
        curr.next = new SNode(3); curr = curr.next;
        curr.next = new SNode(4); curr = curr.next;
        curr.next = new SNode(5); curr = curr.next;
        SNode head = dummy.next;
        System.out.println(nthFromEnd(head, 2).val);
    }
}
