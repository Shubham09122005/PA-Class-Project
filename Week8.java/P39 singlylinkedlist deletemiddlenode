class SNode {
    int val;
    SNode next;
    SNode(int val) { this.val = val; }
}

public class P39_SinglyLinkedList_DeleteMiddleNode {
    static void print(SNode head) {
        SNode temp = head;
        while (temp != null) { System.out.print(temp.val + " "); temp = temp.next; }
        System.out.println();
    }

    static SNode deleteMiddle(SNode head) {
        if (head == null || head.next == null) return null;
        SNode slow = head, fast = head, prev = null;
        while (fast != null && fast.next != null) {
            prev = slow;
            slow = slow.next;
            fast = fast.next.next;
        }
        prev.next = slow.next;
        return head;
    }

    public static void main(String[] args) {
        SNode dummy = new SNode(0);
        SNode curr = dummy;
        curr.next = new SNode(1); curr = curr.next;
        curr.next = new SNode(2); curr = curr.next;
        curr.next = new SNode(3); curr = curr.next;
        curr.next = new SNode(4); curr = curr.next;
        curr.next = new SNode(5); curr = curr.next;
        SNode head = dummy.next;
        head = deleteMiddle(head);
        print(head);
    }
}
