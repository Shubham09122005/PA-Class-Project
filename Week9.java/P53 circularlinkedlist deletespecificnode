class CNode {
    int val;
    CNode next;
    CNode(int val) { this.val = val; }
}

public class P53_CircularLinkedList_DeleteSpecificNode {
    static CNode last;

    static void insertEnd(int val) {
        CNode node = new CNode(val);
        if (last == null) { last = node; last.next = last; return; }
        node.next = last.next;
        last.next = node;
        last = node;
    }

    static void deleteNode(int val) {
        if (last == null) return;
        CNode curr = last.next, prev = last;
        do {
            if (curr.val == val) {
                if (curr == last && curr.next == last) { last = null; return; }
                prev.next = curr.next;
                if (curr == last) last = prev;
                return;
            }
            prev = curr;
            curr = curr.next;
        } while (curr != last.next);
    }

    static void printForward() {
        if (last == null) return;
        CNode curr = last.next;
        do {
            System.out.print(curr.val + " ");
            curr = curr.next;
        } while (curr != last.next);
        System.out.println();
    }

    public static void main(String[] args) {
        for (int v : new int[]{1, 2, 3, 4, 5}) insertEnd(v);
        deleteNode(3);
        printForward();
    }
}
